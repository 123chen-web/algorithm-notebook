# 必须修改后才能注册账号；将邀请码发给你的内测用户。
INVITE_CODE=change-me

# 配置的用户名作为保留名；不提供公开注册或启动授予管理员的入口。
# 当前已发布的迁移 4 只添加账号字段，不含按名字回填；本轮保持旧迁移不变。
# 公开注册永远创建普通用户；修改此项不会提权或撤权，既有管理员身份不变。
# 管理员身份由 users.is_admin 保存，仅用 admin_tool.py grant/revoke 显式管理。
# 名字存在规范化冲突时工具拒绝授权，请先 check-usernames，再用 --id 指定用户。
ADMIN_USERNAME=

# 服务条款与隐私政策的运营者名称、联系邮箱；上线前填写真实信息。
# 留空时分别显示“本站管理员”和“请通过站内渠道联系管理员”。
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# 不填时，记录和复习功能仍然可用，AI 生成功能不可用。
# 注意：变量名里的 OPENAI 只是“OpenAI 兼容接口”的叫法。我们线上用的是 DeepSeek（国内可直连，
# 不需要翻墙）：在下面填 DeepSeek 的 Key，并设置 OPENAI_BASE_URL=https://api.deepseek.com。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 默认（留空）请求真正的 OpenAI。填其他"OpenAI 兼容"服务商的地址即可
# 切换服务商，同时把上面两项换成它的 Key 和模型名，代码不用改。
# 比如 DeepSeek：把 OPENAI_API_KEY 换成 DeepSeek 的 Key，OPENAI_MODEL
# 换成它当前的模型名，这里填 https://api.deepseek.com
# （具体模型名和价格以 DeepSeek 官方文档为准，会更新）。
OPENAI_BASE_URL=

# 相对路径以项目目录为基准。
DATABASE_PATH=data/notebook.db

# 每个用户按其账号时区计算的每日 AI 请求上限。
# 调用失败也占用次数，避免失败重试造成无上限的成本。
AI_DAILY_LIMIT=10

# 同时进行中的 AI 调用上限；超出返回 429，且不消耗每日额度。
AI_MAX_CONCURRENCY=6

# 免邀请码"体验账号"（POST /api/auth/trial）单独的每日 AI 生成上限，
# 应该远低于 AI_DAILY_LIMIT——这个接口任何人都能触发，额度设太高
# 等于把 AI_DAILY_LIMIT 变成"任何人每天可用次数 × 无限个体验账号"。
TRIAL_AI_DAILY_LIMIT=2

# 本地 HTTP 使用 0；部署到 HTTPS 后改为 1。
COOKIE_SECURE=0

# 仅本地支付联调使用。默认关闭，不连接支付宝或微信支付平台。
# 启用时填写独立随机密钥，用于 HMAC-SHA256 回调签名；不要发送给前端。
PAYMENTS_MOCK_ENABLED=0
PAYMENTS_MOCK_SECRET=

# 支付宝当面付（扫码，alipay.trade.precreate），使用 RSA2 公钥模式。
# PAYMENTS_MOCK_ENABLED=1 时两种渠道均使用 Mock，真实支付宝回调路由关闭；
# 使用真实/沙箱支付宝时设为 0。以下五项缺任何一项都会拒绝下单（503）。
# 在 https://open.alipay.com 开放平台创建自用应用、获取 APPID，申请/签约当面付。
ALIPAY_APP_ID=
# 收款支付宝账户的商户 PID（通常 2088 开头），在商家/开放平台账户信息中查看。
# 不是 APPID，用于核对异步通知 seller_id，确保钱付给了本商户。
ALIPAY_SELLER_ID=
# 使用支付宝开放平台密钥工具生成 RSA2 / 2048 位应用密钥对；
# 应用私钥只留服务端，把对应的「应用公钥」上传到应用的接口加签设置。
# 上传后从同一页面取得「支付宝公钥」用于验签（不是你自己的应用公钥）。
# 支持完整 PEM 的真实换行，以及单行字符串中的字面量 \n。推荐单引号格式：
# ALIPAY_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nMII...你的应用私钥...\n-----END PRIVATE KEY-----'
# ALIPAY_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nMII...支付宝公钥...\n-----END PUBLIC KEY-----'
# 应用私钥也支持 BEGIN RSA PRIVATE KEY / END RSA PRIVATE KEY（PKCS#1）。
# 保留 PEM 首尾标记及密钥原有分行；勿把示例占位文本当成密钥。
# python-dotenv 的双引号值会展开 \n，单引号值由适配器展开，均可使用。
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 你部署的、支付宝服务器可访问的完整通知地址；无需登录或 CSRF 请求头。
# 例如 https://notebook.example.com/api/payments/alipay/callback（替换为真实域名）。
# 本地回环地址不能供支付宝回调；下单时把此 URL 传给 precreate。
ALIPAY_NOTIFY_URL=
# 0=正式网关（默认）；1=沙箱网关，仅接受 0/1。
# 沙箱 APPID/账户/支付宝公钥从开放平台「沙箱环境」获取，不要与正式配置混用。
ALIPAY_SANDBOX=0

# 微信支付 Native 支付（扫码），APIv3，使用"微信支付平台公钥模式"（不是平台证书模式，
# 不需要自动下载/缓存平台证书到本地目录）。PAYMENTS_MOCK_ENABLED=1 时两种渠道均使用
# Mock；使用真实微信支付时设为 0。以下八项缺任何一项都会拒绝下单（503）。
# 微信支付没有沙箱环境，联调只能用真实商户号小额（如 0.01 元）交易。
# 商户平台 https://pay.weixin.qq.com 「产品中心-开发配置」申请 Native 支付权限。
WECHAT_APP_ID=
# 商户号，「账户中心-商户信息」查看。
WECHAT_MCH_ID=
# 商户 API 证书序列号：「账户中心-API安全-申请API证书」申请证书后，
# 在证书详情里查看序列号（不是商户号，也不是 APPID）。
WECHAT_CERT_SERIAL_NO=
# 申请 API 证书时生成的商户私钥文件 apiclient_key.pem 的内容。支持完整 PEM 的真实
# 换行，以及单行字符串中的字面量 \n。推荐单引号格式：
# WECHAT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nMII...商户私钥...\n-----END PRIVATE KEY-----'
WECHAT_PRIVATE_KEY=
# 「账户中心-API安全-微信支付公钥」菜单里下载的微信支付平台公钥（不是商户自己的
# 公钥，也不是上面的商户私钥对应的公钥）。格式要求同 WECHAT_PRIVATE_KEY。
WECHAT_PUBLIC_KEY=
# 同一页面复制的平台公钥 ID，形如 PUB_KEY_ID_0112345678900000000000000000123456。
WECHAT_PUBLIC_KEY_ID=
# APIv3 密钥：「账户中心-API安全-设置APIv3密钥」自行设置的 32 位字符串
# （不是从后台下载的，是你自己设置的一串密钥），用于回调通知的 AES-256-GCM 解密。
WECHAT_API_V3_KEY=
# 你部署的、微信支付服务器可访问的完整通知地址；无需登录或 CSRF 请求头。
# 例如 https://notebook.example.com/api/payments/wechat/callback（替换为真实域名）。
# 本地回环地址不能供微信支付回调；下单时把此 URL 传给统一下单接口。
WECHAT_NOTIFY_URL=

# 找回密码邮件、每日复习提醒邮件的发信配置。不填时这两个功能不可用，
# 其余功能不受影响。填好后先运行 `python check_mail.py --to 你的邮箱` 自测
# （分步计时，失败会用中文说明原因）。三套完整示例见 docs/operations/mail.md。
#
# SMTP_SECURITY：
#   starttls（默认）= 先连明文端口再升级加密，常用 587；
#   ssl            = 直接加密连接，常用 465（QQ / 163 推荐，国内网络更稳）；
#   none           = 不加密，只用于本机调试用的 SMTP 服务。
# SMTP_PORT 不填时：ssl 用 465，其余用 587。
# SMTP_TIMEOUT：连接、握手、登录、发送每一步的超时秒数，默认 15。
#
# QQ 邮箱：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，SMTP_SECURITY=ssl，
#   SMTP_PASSWORD 填邮箱设置里生成的「授权码」（不是 QQ 密码）。
# 163 邮箱：SMTP_HOST=smtp.163.com，SMTP_PORT=465，SMTP_SECURITY=ssl，
#   SMTP_PASSWORD 填「客户端授权密码」。
# Gmail：SMTP_HOST=smtp.gmail.com，SMTP_PORT=587，SMTP_SECURITY=starttls，
#   SMTP_PASSWORD 填 https://myaccount.google.com/apppasswords 生成的
#   16 位「应用专用密码」（需先开启两步验证）；国内网络通常连不上。
# 也可以填其他服务商（比如 Resend）提供的 SMTP 地址、端口和账号密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15
SMTP_USERNAME=
SMTP_PASSWORD=
# 不填时使用 SMTP_USERNAME 作为发件人地址。QQ / 163 要求它与登录邮箱一致。
SMTP_FROM=

# 找回密码邮件里的链接用这个地址拼接。本地开发不用改；
# 部署上线后必须改成真实域名（带 https://），否则邮件里的链接会指向
# 127.0.0.1，用户点了打不开。
PUBLIC_BASE_URL=http://127.0.0.1:8000
