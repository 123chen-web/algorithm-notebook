# 必须修改后才能注册账号；将邀请码发给你的内测用户。
INVITE_CODE=change-me

# 不填时，记录和复习功能仍然可用，AI 生成功能不可用。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 相对路径以项目目录为基准。
DATABASE_PATH=data/notebook.db

# 每个用户按其账号时区计算的每日 AI 请求上限。
# 调用失败也占用次数，避免失败重试造成无上限的成本。
AI_DAILY_LIMIT=10

# 本地 HTTP 使用 0；部署到 HTTPS 后改为 1。
COOKIE_SECURE=0

# 找回密码邮件、每日复习提醒邮件的发信配置。不填时这两个功能不可用，
# 其余功能不受影响。
#
# 使用 Gmail：
#   1. 给这个 Gmail 账号开启两步验证。
#   2. 打开 https://myaccount.google.com/apppasswords 生成一个
#      "应用专用密码"（16 位，不是登录密码本身）。
#   3. SMTP_HOST=smtp.gmail.com，SMTP_PORT=587，
#      SMTP_USERNAME 填完整 Gmail 地址，SMTP_PASSWORD 填应用专用密码。
# 也可以填其他服务商（比如 Resend）提供的 SMTP 地址、端口和账号密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 不填时使用 SMTP_USERNAME 作为发件人地址。
SMTP_FROM=

# 找回密码邮件里的链接用这个地址拼接。本地开发不用改；
# 部署上线后必须改成真实域名（带 https://），否则邮件里的链接会指向
# 127.0.0.1，用户点了打不开。
PUBLIC_BASE_URL=http://127.0.0.1:8000
