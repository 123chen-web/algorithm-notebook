# ============================================================
# 欧叶OY 生产环境配置模板
#
# 用法：在服务器上执行 cp deploy/.env.prod.example .env
# 然后用文本编辑器填写 .env（nano .env），填完后执行：
# chmod 600 .env
#
# ！！！这个文件是模板，里面不要填任何真实密钥！！！
# 真实密钥只在服务器上的.env 里填，.env 永远不要提交到 Git。
# ============================================================

# ---------- 必填：站点域名 ----------
# 你在域名服务商那里买好的域名，不带 https://，例如：
# SITE_DOMAIN=notebook.example.com
# Caddy 用它自动申请 HTTPS 证书；域名必须先解析到服务器 IP。
SITE_DOMAIN=

# ---------- 必填：注册邀请码 ----------
# 必须改成一个别人猜不到的强口令（建议 16 位以上，字母+数字），
# 没有它任何人都注册不了。示例生成方法（在服务器上执行）：
# python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# 把输出贴到下面。不要用 "change-me"、"123456"、生日、手机号。
INVITE_CODE=

# ---------- 必填：邮件里的链接地址 ----------
# 找回密码邮件里的链接用它拼接，必须是真实域名（带 https://），
# 否则用户点的链接会打不开。示例：
# PUBLIC_BASE_URL=https://notebook.example.com
PUBLIC_BASE_URL=

# ---------- 生产安全（已按生产填好，一般不用改） ----------
# HTTPS 下 Cookie 必须带 Secure 标记，否则浏览器可能拒绝发送登录 Cookie。
COOKIE_SECURE=1

# ---------- 可选：运营者信息（建议填） ----------
# 服务条款与隐私政策页面上显示的运营者名称和联系邮箱。
# 上线前填真实信息；留空时分别显示"本站管理员"和"请通过站内渠道联系管理员"。
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# ---------- 可选：AI 功能 ----------
# 不填时 AI 生成功能不可用，其他功能不受影响。
# 我们用的是 DeepSeek（OpenAI 兼容接口，国内可直连）：
# OPENAI_API_KEY=填 DeepSeek 的 Key
# OPENAI_MODEL=deepseek-chat（以 DeepSeek 官方文档为准）
# OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# 每个用户按其账号时区计算的每日 AI 请求上限；调用失败也占用次数。
AI_DAILY_LIMIT=10
# 同时进行中的 AI 调用上限；超出返回 429，且不消耗每日额度。
AI_MAX_CONCURRENCY=6
# 免邀请码"体验账号"单独的每日 AI 生成上限，应远低于 AI_DAILY_LIMIT。
TRIAL_AI_DAILY_LIMIT=2

# ---------- 可选：发信配置（找回密码、复习提醒邮件） ----------
# 不填时这两个功能不可用，其余功能不受影响。
# 常用示例（QQ 邮箱）：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USERNAME=你的QQ邮箱
# SMTP_PASSWORD=邮箱设置里生成的"授权码"（不是 QQ 密码）
# 填好后先自测：docker compose -f deploy/docker-compose.prod.yml exec app python check_mail.py --to 你的邮箱
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- 可选：支付（本地联调默认关闭） ----------
# V1 上线建议先用"手动收款"（个人收款码，见 docs/operations/manual-payment.md），
# 不需要填下面这些。以后要接支付宝/微信支付时再按.env.example 的逐项说明填写。
PAYMENTS_MOCK_ENABLED=0
PAYMENTS_MOCK_SECRET=

# ---------- 数据路径（一般不用改） ----------
# 容器内固定路径；数据实际落在宿主机的 /srv/algorithm-notebook/data。
DATABASE_PATH=/app/data/notebook.db
AVATAR_DIR=/app/data/avatars
PAY_QR_DIR=/app/data/pay-qr
# 备份输出目录与保留份数（容器内路径，对应宿主机 data/backups）。
BACKUP_DIR=/app/data/backups
BACKUP_KEEP=30

# ---------- 以下保留名配置，不授予管理员 ----------
# 管理员身份只用 admin_tool.py grant/revoke 管理，改这里不会提权。
ADMIN_USERNAME=
